     cp2up_pdr->precedence = OGS_PFCP_CP2UP_PDR_PRECEDENCE;
     up2cp_pdr->precedence = OGS_PFCP_UP2CP_PDR_PRECEDENCE;
 
+    create_t2_a17_charged_pdr(sess);
+
     ogs_assert(OGS_OK ==
             smf_5gc_pfcp_send_session_establishment_request(sess, stream, 0));
 
