diff --git a/src/smf/npcf-handler.c b/src/smf/npcf-handler.c
index a51a89384..e1ac749f7 100644
--- a/src/smf/npcf-handler.c
+++ b/src/smf/npcf-handler.c
@@ -25,6 +25,72 @@
 
 #include "npcf-handler.h"
 
+/*
+ * selected-standard-scenario common fixture: a charged uplink PDR overlaps the normal broader
+ * uncharged forwarding fallback.  The matched pair changes only the charged
+ * PDR precedence value.
+ */
+static void create_t2_a17_charged_pdr(smf_sess_t *sess)
+{
+    smf_bearer_t *default_qos_flow = NULL;
+    ogs_pfcp_pdr_t *default_ul_pdr = NULL;
+    ogs_pfcp_pdr_t *charged_ul_pdr = NULL;
+    const char *flow_description = "permit out ip from any to assigned";
+    int i;
+
+    ogs_assert(sess);
+
+    default_qos_flow = smf_default_bearer_in_sess(sess);
+    ogs_assert(default_qos_flow);
+    default_ul_pdr = default_qos_flow->ul_pdr;
+    ogs_assert(default_ul_pdr);
+    ogs_assert(default_qos_flow->ul_far);
+    ogs_assert(default_qos_flow->urr);
+    ogs_assert(default_qos_flow->qer);
+
+    charged_ul_pdr = ogs_pfcp_pdr_add(&sess->pfcp);
+    ogs_assert(charged_ul_pdr);
+
+    ogs_assert(sess->session.name);
+    charged_ul_pdr->apn = ogs_strdup(sess->session.name);
+    ogs_assert(charged_ul_pdr->apn);
+
+    charged_ul_pdr->src_if = OGS_PFCP_INTERFACE_ACCESS;
+    charged_ul_pdr->src_if_type_presence = true;
+    if (HOME_ROUTED_ROAMING_IN_HSMF(sess))
+        charged_ul_pdr->src_if_type =
+            OGS_PFCP_3GPP_INTERFACE_TYPE_N9_FOR_ROAMING;
+    else
+        charged_ul_pdr->src_if_type =
+            OGS_PFCP_3GPP_INTERFACE_TYPE_N3_3GPP_ACCESS;
+
+    memcpy(&charged_ul_pdr->f_teid, &default_ul_pdr->f_teid,
+            sizeof(charged_ul_pdr->f_teid));
+    charged_ul_pdr->f_teid_len = default_ul_pdr->f_teid_len;
+    charged_ul_pdr->outer_header_removal_len = 1;
+    charged_ul_pdr->outer_header_removal.description =
+        OGS_PFCP_OUTER_HEADER_REMOVAL_GTPU_UDP_IP;
+    charged_ul_pdr->qfi = default_ul_pdr->qfi;
+    charged_ul_pdr->flow[0].fd = 1;
+    charged_ul_pdr->flow[0].description = ogs_strdup(flow_description);
+    ogs_assert(charged_ul_pdr->flow[0].description);
+    charged_ul_pdr->num_of_flow = 1;
+
+    for (i = 0; i < OGS_ARRAY_SIZE(default_ul_pdr->urr); i++)
+        default_ul_pdr->urr[i] = NULL;
+    default_ul_pdr->num_of_urr = 0;
+
+    ogs_pfcp_pdr_associate_far(charged_ul_pdr, default_qos_flow->ul_far);
+    ogs_pfcp_pdr_associate_urr(charged_ul_pdr, default_qos_flow->urr);
+    ogs_pfcp_pdr_associate_qer(charged_ul_pdr, default_qos_flow->qer);
+    ogs_pfcp_pdr_reorder_by_precedence(charged_ul_pdr, 100000);
+
+    ogs_warn("selected-standard-scenario fixture: charged pdr[%u] urr[%u] precedence[%u], "
+            "fallback pdr[%u] urr_count[%d]", charged_ul_pdr->id,
+            default_qos_flow->urr->id, charged_ul_pdr->precedence,
+            default_ul_pdr->id, default_ul_pdr->num_of_urr);
+}
+
 static void update_authorized_pcc_rule_and_qos(
         smf_sess_t *sess, OpenAPI_sm_policy_decision_t *SmPolicyDecision)
 {
