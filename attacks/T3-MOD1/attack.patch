+            urr->id, report->usage_report[idx].seqn,
+            (unsigned long)inflation_factor,
+            (unsigned long long)actual_total,
+            (unsigned long long)actual_ul,
+            (unsigned long long)actual_dl,
+            (unsigned long long)
+                report->usage_report[idx].vol_measurement.total_volume,
+            (unsigned long long)
+                report->usage_report[idx].vol_measurement.uplink_volume,
+            (unsigned long long)
