@@ -1739,7 +1741,16 @@ uint8_t smf_n4_handle_session_report_request(
             if (use_rep->urr_id.presence == 0)
                 continue;
             urr_id = use_rep->urr_id.u32;
-            if (!bearer || !bearer->urr || bearer->urr->id != urr_id)
