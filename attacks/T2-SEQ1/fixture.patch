+static int send_t2_a02_operation(
+        smf_sess_t *sess,
+        ogs_pkbuf_t *(*builder)(
+            uint8_t type, smf_sess_t *sess, ogs_pfcp_xact_t *xact),
+        uint64_t discriminator)
+{
+    ogs_pfcp_xact_t *xact = NULL;
+
+    ogs_assert(sess);
+    ogs_assert(builder);
+
+    xact = ogs_pfcp_xact_local_create(
+            sess->pfcp_node, sess_5gc_timeout, OGS_UINT_TO_POINTER(sess->id));
+    if (!xact) {
+        ogs_error("ogs_pfcp_xact_local_create() failed");
+        return OGS_ERROR;
+    }
+
+    xact->local_seid = sess->smf_n4_seid;
+    xact->modify_flags =
+        OGS_PFCP_MODIFY_SESSION |
+        OGS_PFCP_MODIFY_CREATE |
+        OGS_PFCP_MODIFY_URR |
+        discriminator;
+
+    return smf_pfcp_send_modify_list(sess, builder, xact, 0);
+}
+
+int smf_t2_a02_send_current_operation(smf_sess_t *sess)
+{
+    return send_t2_a02_operation(
+            sess, smf_n4_build_t2_a02_current_operation,
+            OGS_PFCP_MODIFY_NETWORK_REQUESTED);
+}
+
+int smf_t2_a02_send_stale_replay(smf_sess_t *sess)
+{
+    return send_t2_a02_operation(
+            sess, smf_n4_build_t2_a02_stale_replay,
+            OGS_PFCP_MODIFY_UE_REQUESTED);
+}
