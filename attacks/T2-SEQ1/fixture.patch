+static ogs_pfcp_pdr_t *find_t2_a02_charged_uplink_pdr(smf_sess_t *sess)
+{
+    ogs_pfcp_pdr_t *pdr = NULL;
+
+    ogs_assert(sess);
+
+    ogs_list_for_each(&sess->pfcp.pdr_list, pdr) {
+        if (pdr->src_if == OGS_PFCP_INTERFACE_ACCESS &&
+            pdr->num_of_urr > 0)
+            return pdr;
+    }
+
+    return NULL;
+}
+
+static ogs_pkbuf_t *build_t2_a02_create_pdr(
+        uint8_t type, smf_sess_t *sess, bool include_urr,
+        const char *operation)
+{
+    ogs_pfcp_message_t *pfcp_message = NULL;
+    ogs_pfcp_session_modification_request_t *req = NULL;
+    ogs_pfcp_pdr_t *pdr = NULL;
+    ogs_pkbuf_t *pkbuf = NULL;
+    int i;
+
+    pdr = find_t2_a02_charged_uplink_pdr(sess);
+    if (!pdr) {
+        ogs_error("selected-standard-scenario charged uplink PDR not found");
+        return NULL;
+    }
+
+    pfcp_message = ogs_calloc(1, sizeof(*pfcp_message));
+    if (!pfcp_message) {
+        ogs_error("ogs_calloc() failed");
+        return NULL;
+    }
+    req = &pfcp_message->pfcp_session_modification_request;
+
+    ogs_pfcp_pdrbuf_init();
+    ogs_pfcp_build_create_pdr(&req->create_pdr[0], 0, pdr);
+    if (!include_urr) {
+        for (i = 0; i < OGS_ARRAY_SIZE(req->create_pdr[0].urr_id); i++)
+            memset(&req->create_pdr[0].urr_id[i], 0,
+                    sizeof(req->create_pdr[0].urr_id[i]));
+    }
+
+    pfcp_message->h.type = type;
+    pkbuf = ogs_pfcp_build_msg(pfcp_message);
+    ogs_expect(pkbuf);
+
+    ogs_warn("selected-standard-scenario %s emitted Create PDR id[%u] urr_count[%d]",
+            operation, pdr->id, include_urr ? pdr->num_of_urr : 0);
+
+    ogs_pfcp_pdrbuf_clear();
+    ogs_free(pfcp_message);
+    return pkbuf;
+}
+
+ogs_pkbuf_t *smf_n4_build_t2_a02_current_operation(
+        uint8_t type, smf_sess_t *sess, ogs_pfcp_xact_t *xact)
+{
+    ogs_assert(xact);
+    return build_t2_a02_create_pdr(type, sess, false, "current operation");
+}
+
+ogs_pkbuf_t *smf_n4_build_t2_a02_stale_replay(
+        uint8_t type, smf_sess_t *sess, ogs_pfcp_xact_t *xact)
+{
+    ogs_assert(xact);
+    return build_t2_a02_create_pdr(type, sess, true, "stale replay");
+}
